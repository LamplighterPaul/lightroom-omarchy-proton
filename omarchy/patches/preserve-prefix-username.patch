 BOOL WINAPI GetUserNameA( LPSTR name, LPDWORD size )
 {
     static const char steamuserA[] = {'s','t','e','a','m','u','s','e','r',0};
+    DWORD len;
+
+    /* Keep the identity used to protect credentials when migrating a prefix.
