@@ -394,6 +395,35 @@
 
 #ifdef HAVE_XRRGETPROVIDERRESOURCES
 
+static int crtc_query_error_handler( Display *display, XErrorEvent *event, void *arg )
+{
+    const RRCrtc *crtc = arg;
+
+    return event->request_code == xrandr_opcode &&
+           event->minor_code == X_RRGetCrtcInfo &&
+           event->error_code == xrandr_error_base + BadRRCrtc &&
+           event->resourceid == *crtc;
+}
+
+static XRRCrtcInfo *xrandr_get_crtc_info( XRRScreenResources *resources, RRCrtc crtc )
+{
+    XRRCrtcInfo *info;
+
+    /* Output reconfiguration can retire a CRTC after the resources snapshot.
+     * XRRGetCrtcInfo returns NULL on failure, but Xlib first invokes its error
+     * handler, whose default action is to terminate the process. Let callers
+     * take their existing missing-CRTC paths for this specific query error.
+     * The reply is synchronous, so no additional XSync round trip is needed. */
+    X11DRV_expect_error( gdi_display, crtc_query_error_handler, &crtc );
+    info = pXRRGetCrtcInfo( gdi_display, resources, crtc );
+    if (X11DRV_check_error())
+    {
+        if (info) pXRRFreeCrtcInfo( info );
+        return NULL;
+    }
+    return info;
+}
