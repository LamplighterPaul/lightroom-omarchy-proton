+/* Private-fixture appearance diagnostic. Readback is intentionally intrusive. */
+void lrcc_trace_pixel( const char *phase, Window window, HWND hwnd, Window source )
+{
+    const char *enabled = getenv( "LRCC_PIXEL_TRACE" );
+    const char *trigger = getenv( "LRCC_PIXEL_TRACE_TRIGGER" );
+    const char *display = getenv( "DISPLAY" );
+    Window root;
+    unsigned int width, height, border, depth;
+    int x, y;
+    XImage *image;
+    struct timespec stamp;
+    unsigned long pixel;
+    FILE *control;
+    int mode;
+
+    if (!enabled || strcmp( enabled, "1" ) || !display || strcmp( display, ":1" ) ||
+        !trigger || access( trigger, F_OK ) || !window) return;
+    if (!(control = fopen( trigger, "r" ))) return;
+    mode = fgetc( control );
+    fclose( control );
+    if (mode == 't' && strncmp( phase, "pat-", 4 )) return;
+    if (mode == 'b' && strcmp( phase, "gpu-before" )) return;
+    if ((mode == 'a' || mode == 's') && strcmp( phase, "gpu-after" )) return;
+    if (mode == 's') { XSync( gdi_display, False ); return; }
+    if (!XGetGeometry( gdi_display, window, &root, &x, &y, &width, &height, &border, &depth ) ||
+        width < 2000 || height < 1000) return;
+    if (!(image = XGetImage( gdi_display, window, 1400, 700, 1, 1, AllPlanes, ZPixmap ))) return;
+    pixel = XGetPixel( image, 0, 0 );
+    clock_gettime( CLOCK_REALTIME, &stamp );
+    fprintf( stderr, "LRCC_PIXEL %ld.%09ld tid=%lx phase=%s dst=%lx hwnd=%p src=%lx rgb=%06lx\n",
+             stamp.tv_sec, stamp.tv_nsec, (unsigned long)pthread_self(), phase, window, hwnd, source, pixel & 0xffffff );
+    XDestroyImage( image );
+}
