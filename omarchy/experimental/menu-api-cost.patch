@@ -31,6 +33,48 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(menu);
 WINE_DECLARE_DEBUG_CHANNEL(accel);
+
+/* Diagnostic aggregate costs only between posting a menu character and polling it. */
+struct lr_menu_cost { BOOL active; ULONGLONG wall, cpu, elapsed[4]; unsigned count[4]; };
+static __thread struct lr_menu_cost lr_cost;
+static ULONGLONG lr_cost_clock( clockid_t clock )
+{
+    struct timespec ts;
+    clock_gettime( clock, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+void lr_menu_cost_begin(void)
+{
+    if (!getenv( "LIGHTROOM_OMARCHY_INPUT_COST" )) return;
+    memset( &lr_cost, 0, sizeof(lr_cost) );
+    lr_cost.wall = lr_cost_clock( CLOCK_MONOTONIC );
+    lr_cost.cpu = lr_cost_clock( CLOCK_THREAD_CPUTIME_ID );
+    lr_cost.active = TRUE;
+}
+void lr_menu_cost_finish(void)
+{
+    ULONGLONG wall, cpu;
+    if (!lr_cost.active) return;
+    wall = lr_cost_clock( CLOCK_MONOTONIC ) - lr_cost.wall;
+    cpu = lr_cost_clock( CLOCK_THREAD_CPUTIME_ID ) - lr_cost.cpu;
+    lr_cost.active = FALSE;
+    WARN( "LR_COST wall_ns=%llu cpu_ns=%llu enable_count=%u enable_ns=%llu check_count=%u check_ns=%llu info_count=%u info_ns=%llu draw_count=%u draw_ns=%llu\n",
+          (unsigned long long)wall, (unsigned long long)cpu,
+          lr_cost.count[0], (unsigned long long)lr_cost.elapsed[0],
+          lr_cost.count[1], (unsigned long long)lr_cost.elapsed[1],
+          lr_cost.count[2], (unsigned long long)lr_cost.elapsed[2],
+          lr_cost.count[3], (unsigned long long)lr_cost.elapsed[3] );
+}
+static ULONGLONG lr_menu_api_start(void)
+{
+    return lr_cost.active ? lr_cost_clock( CLOCK_MONOTONIC ) : 0;
+}
+static void lr_menu_api_end( unsigned kind, ULONGLONG start )
+{
+    if (!start) return;
+    lr_cost.count[kind]++;
+    lr_cost.elapsed[kind] += lr_cost_clock( CLOCK_MONOTONIC ) - start;
+}
 
