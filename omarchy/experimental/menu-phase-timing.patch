--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -43,6 +43,25 @@
     if ((slash = wcsrchr( name, '\\' ))) name = slash + 1;
     if ((slash = wcsrchr( name, '/' ))) name = slash + 1;
     return !wcsicmp( name, u"lightroom.exe" );
+}
+
+/* Opt-in, phase-only diagnostics: no menu text or document data. */
+static LONGLONG lightroom_menu_stamp(void)
+{
+    LARGE_INTEGER counter;
+    const char *enabled = getenv( "LIGHTROOM_OMARCHY_MENU_TIMING" );
+    if (!enabled || strcmp( enabled, "1" )) return 0;
+    NtQueryPerformanceCounter( &counter, NULL );
+    return counter.QuadPart;
+}
+
+static void lightroom_menu_elapsed( const char *phase, LONGLONG start )
+{
+    LARGE_INTEGER counter, frequency;
+    if (!start) return;
+    NtQueryPerformanceCounter( &counter, &frequency );
+    WARN( "LR_MENU phase=%s duration_ms=%.3f\n", phase,
+          (counter.QuadPart - start) * 1000.0 / frequency.QuadPart );
 }
 
 /* menu item structure */
@@ -3113,7 +3132,11 @@
 
     max_height = info.rcWork.bottom - info.rcWork.top;
     if (menu->cyMax) max_height = min( max_height, menu->cyMax );
-    calc_popup_menu_size( menu, max_height );
+    {
+        LONGLONG stamp = lightroom_menu_stamp();
+        calc_popup_menu_size( menu, max_height );
+        lightroom_menu_elapsed( "popup-layout", stamp );
+    }
 
     /* adjust popup menu pos so that it fits within the desktop */
     if (flags & TPM_LAYOUTRTL) flags ^= TPM_RIGHTALIGN;
@@ -3145,9 +3168,15 @@
     }
 
