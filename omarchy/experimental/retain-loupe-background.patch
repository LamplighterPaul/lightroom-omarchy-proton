+static struct list lr_client_surfaces = LIST_INIT(lr_client_surfaces);
+static pthread_mutex_t lr_client_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Lightroom redraws loupeView with a full-client PATCOPY before its next GPU
+ * frame. On X11 that fill overwrites the retained photo in the parent drawable.
+ * Keep this app workaround opt-in, and only while a live native presenter owns
+ * the window and has successfully copied at least one frame. */
+BOOL lrcc_preserve_loupe_background( const X11DRV_PDEVICE *dev, const struct bitblt_coords *dst, DWORD rop )
+{
+    const char *enabled = getenv( "LIGHTROOM_OMARCHY_RETAIN_LOUPE" );
+    struct x11drv_client_surface *surface;
+    BOOL ret = FALSE;
+
+    if (!enabled || strcmp( enabled, "1" ) || rop != PATCOPY || dst->x || dst->y) return FALSE;
+    /* No NtUser calls here: this path runs under the DC lock. Match the
+     * destination cached by a successful native presentation instead. */
+    pthread_mutex_lock( &lr_client_lock );
+    LIST_FOR_EACH_ENTRY( surface, &lr_client_surfaces, struct x11drv_client_surface, lr_entry )
+        if (surface->lr_eligible && surface->lr_presented && surface->lr_hwnd == dev->dc_hwnd &&
+            surface->lr_drawable == dev->drawable &&
+            surface->lr_rect.left == dev->dc_rect.left && surface->lr_rect.top == dev->dc_rect.top &&
+            surface->lr_rect.right - surface->lr_rect.left == dst->width &&
+            surface->lr_rect.bottom - surface->lr_rect.top == dst->height &&
+            ReadAcquire( &surface->client.native_ref ) > 0 &&
+            ReadAcquire( &surface->client.presentation_owner ))
+        {
+            ret = TRUE;
+            break;
+        }
+    pthread_mutex_unlock( &lr_client_lock );
+    return ret;
+}
+
+static BOOL lrcc_is_loupe_window( HWND hwnd )
+{
+    static const WCHAR loupe_class[] = {'l','o','u','p','e','V','i','e','w',0};
+    WCHAR name[64];
+    UNICODE_STRING class_name = {0, sizeof(name), name};
+    return NtUserGetAncestor( hwnd, GA_ROOT ) != hwnd &&
+           NtUserGetClassName( hwnd, FALSE, &class_name ) == 9 &&
+           !memcmp( name, loupe_class, 9 * sizeof(WCHAR) );
+}
