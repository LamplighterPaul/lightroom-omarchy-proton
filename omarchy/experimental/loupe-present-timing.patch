+/* Diagnostic only: fixed-size shared mapping, no readbacks or per-frame I/O.
+ * A row is valid only when its final commit word equals its 1-based index.
+ * Stop at capacity rather than overwrite observations. Initialization precedes
+ * the first measured callback. Consumers must inspect committed rows only. */
+#define LR_PRESENT_CAPACITY 65536
+struct lr_present_row
+{
+    uint64_t start, geometry, clip, blit, flush, end;
+    uint64_t hwnd, surface, thread, outcome, width, height, commit;
+};
+struct lr_present_trace
+{
+    char magic[8];
+    uint64_t capacity;
+    struct lr_present_row rows[LR_PRESENT_CAPACITY];
+};
+static struct lr_present_trace *lr_present_trace;
+static pthread_once_t lr_present_once = PTHREAD_ONCE_INIT;
+static unsigned int lr_present_next;
+
+static void lr_present_init(void)
+{
+    const char *path = getenv( "LIGHTROOM_OMARCHY_PRESENT_TRACE" );
+    char filename[4096];
+    int fd;
+    void *mapping;
+    if (!path || path[0] != '/') return;
+    if (snprintf( filename, sizeof(filename), "%s.%u.bin", path, (unsigned int)getpid() ) >= sizeof(filename)) return;
+    if ((fd = open( filename, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600 )) == -1) return;
+    if (ftruncate( fd, sizeof(struct lr_present_trace) )) { close( fd ); return; }
+    mapping = mmap( NULL, sizeof(struct lr_present_trace), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    close( fd );
+    if (mapping == MAP_FAILED) return;
+    lr_present_trace = mapping;
+    memcpy( lr_present_trace->magic, "LRPRES01", 8 );
+    lr_present_trace->capacity = LR_PRESENT_CAPACITY;
+}
+
+static uint64_t lr_present_stamp( BOOL enabled )
+{
+    struct timespec now;
+    if (!enabled) return 0;
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+
+static void lr_present_record( struct lr_present_row *row )
+{
+    unsigned int index = __sync_fetch_and_add( &lr_present_next, 1 );
+    if (index >= LR_PRESENT_CAPACITY) return;
+    lr_present_trace->rows[index] = *row;
+    __atomic_store_n( &lr_present_trace->rows[index].commit, index + 1, __ATOMIC_RELEASE );
+}
